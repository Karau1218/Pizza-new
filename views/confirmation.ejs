<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <!--PIZZA ICON ~ SHOWING AS ICON -->
    <link rel="icon" href="images/pizza.png">
    <!-- STYLESHEET LINK - indicated by href -->
    <link rel="stylesheet" href="styles/styles.css">
    <!-- link to JavaScript--> 
     <!-- the defer shows on top of the page when u submit -->
    <script src="js/pizza.js" defer></script>
</head>
<body>
    <main>
    <header>
        <img src="images/pizzaguy.png" alt="Pizza Guy Image">
    <h1>Big Purr Pizza</h1>
    <P id="tagline">I love big purr pizza, cuz why not</P>
    <!-- HR Is for forming the line -->
    <hr> 
    <p>Big purr pizza's pretty good </p> 
    <!--<a id="main-button" href ="#" role ="button">Contact us</a>  --> 
    </header>
    <h1>Thank you for your order, <%= order.firstname %>!</h1> <!--returns the first name in confirmation-->
    <h2> Order Summary</h2>
        <p>Name: <%= order.firstname %> <%= order.lastname %></p>
        <p>Email: <%= order.email %> </p>
        <p>Toppings: <%= order.toppings %> </p>
        <p>Size: <%= order.size %> </p>
        <p>Comment: <%= order.comment %> </p>
        <p>Date/Time: <%= order.timestamp.toLocaleString() %> </p>

    
    
    


    <footer>
        <p>&copy; 2023 Big Purr Pizza</p>
    </footer>
    </main>
</body>
</body>
</body>
</html>



